<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%X{requestId:--}] %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="com.zaxxer.hikari" level="WARN"/>
  <logger name="org.flywaydb" level="WARN"/>
  <logger name="io.zonky" level="WARN"/>
  <logger name="org.apache.catalina.startup.ContextConfig" level="WARN"/>
  <logger name="org.apache.jasper.servlet.TldScanner" level="WARN"/>
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
