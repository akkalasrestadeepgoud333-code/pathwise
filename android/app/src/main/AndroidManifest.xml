<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for at runtime (Android 13+), only after explaining why; declining is fine. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:theme="@style/Theme.Pathwise">

        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".PracticeActivity" android:exported="false" android:label="@string/practice" />
        <activity android:name=".RoomsActivity" android:exported="false" android:label="@string/rooms" />
        <activity android:name=".RoomActivity" android:exported="false" />
        <activity android:name=".DoubtsActivity" android:exported="false" android:label="@string/doubts" />
        <activity android:name=".DoubtActivity" android:exported="false" />
        <activity android:name=".GamesActivity" android:exported="false" android:label="@string/games" />
        <activity android:name=".GameActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".NotificationsActivity" android:exported="false" android:label="@string/notifications" />
    </application>
</manifest>
