<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" android:text="@string/tagline" />
        <TextView style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server" android:labelFor="@+id/server" />
        <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/server_hint" android:inputType="textUri" android:importantForAutofill="no" />
        <TextView android:id="@+id/warning" style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/danger" android:visibility="gone"
            android:text="This address isn't encrypted (http). Use it only on your own network, or use an https address." />
        <TextView android:id="@+id/nameLabel" style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Your name" android:labelFor="@+id/name" android:visibility="gone" />
        <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPersonName" android:autofillHints="name" android:visibility="gone" />
        <TextView style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Email" android:labelFor="@+id/email" />
        <EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
        <TextView style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Password" android:labelFor="@+id/password" />
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" android:autofillHints="password" />
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/danger" android:visibility="gone" />
        <Button android:id="@+id/submit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Sign in" />
        <Button android:id="@+id/toggle" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="New here? Create an account" />
    </LinearLayout>
</ScrollView>